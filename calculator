<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sidebar Calculator</title>
  <style>
    /* Reset & Base Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Fixed Sidebar Wrapper - Left Side */
    .calc-sidebar {
      position: fixed;
      top: 50%;
      left: 0;
      transform: translateY(-50%) translateX(-100%); /* Hidden by default off-screen */
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 9999;
      display: flex;
      align-items: center;
    }

    /* Open State */
    .calc-sidebar.open {
      transform: translateY(-50%) translateX(0);
    }

    /* Toggle Tab Button */
    .calc-toggle-btn {
      position: absolute;
      left: 100%;
      top: 50%;
      transform: translateY(-50%);
      background: #1e293b;
      color: #ffffff;
      border: none;
      padding: 12px 10px;
      cursor: pointer;
      border-radius: 0 8px 8px 0;
      box-shadow: 3px 0 10px rgba(0, 0, 0, 0.15);
      font-size: 18px;
    }

    /* Calculator Container */
    .calculator {
      width: 260px;
      background: #1e293b;
      padding: 16px;
      border-radius: 0 12px 12px 0;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.2);
    }

    /* Calculator Screen */
    .calc-screen {
      width: 100%;
      height: 50px;
      background: #0f172a;
      border: none;
      border-radius: 8px;
      color: #38bdf8;
      font-size: 24px;
      text-align: right;
      padding: 10px;
      margin-bottom: 14px;
      outline: none;
    }

    /* Grid Layout for Buttons */
    .calc-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    /* Button Styling */
    .calc-btn {
      padding: 12px;
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      background: #334155;
      color: #f8fafc;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .calc-btn:hover {
      background: #475569;
    }

    .calc-btn.op {
      background: #f59e0b;
      color: #ffffff;
    }

    .calc-btn.op:hover {
      background: #d97706;
    }

    .calc-btn.action {
      background: #ef4444;
      color: #ffffff;
    }

    .calc-btn.action:hover {
      background: #dc2626;
    }

    .calc-btn.equals {
      background: #10b981;
      color: #ffffff;
      grid-column: span 2;
    }

    .calc-btn.equals:hover {
      background: #059669;
    }
  </style>
</head>
<body>

  <!-- LEFT SIDEBAR CALCULATOR -->
  <div class="calc-sidebar" id="calcSidebar">
    <button class="calc-toggle-btn" id="calcToggle" title="Toggle Calculator">🧮</button>
    <div class="calculator">
      <input type="text" class="calc-screen" id="calcDisplay" readonly placeholder="0">
      <div class="calc-grid">
        <button class="calc-btn action" onclick="clearDisplay()">C</button>
        <button class="calc-btn action" onclick="deleteLast()">⌫</button>
        <button class="calc-btn op" onclick="appendInput('/')">÷</button>
        <button class="calc-btn op" onclick="appendInput('*')">×</button>

        <button class="calc-btn" onclick="appendInput('7')">7</button>
        <button class="calc-btn" onclick="appendInput('8')">8</button>
        <button class="calc-btn" onclick="appendInput('9')">9</button>
        <button class="calc-btn op" onclick="appendInput('-')">-</button>

        <button class="calc-btn" onclick="appendInput('4')">4</button>
        <button class="calc-btn" onclick="appendInput('5')">5</button>
        <button class="calc-btn" onclick="appendInput('6')">6</button>
        <button class="calc-btn op" onclick="appendInput('+')">+</button>

        <button class="calc-btn" onclick="appendInput('1')">1</button>
        <button class="calc-btn" onclick="appendInput('2')">2</button>
        <button class="calc-btn" onclick="appendInput('3')">3</button>
        <button class="calc-btn equals" onclick="calculateResult()">=</button>

        <button class="calc-btn" onclick="appendInput('0')" style="grid-column: span 2;">0</button>
        <button class="calc-btn" onclick="appendInput('.')">.</button>
      </div>
    </div>
  </div>

  <script>
    const sidebar = document.getElementById('calcSidebar');
    const toggleBtn = document.getElementById('calcToggle');
    const display = document.getElementById('calcDisplay');

    // Toggle Sidebar Visibility
    toggleBtn.addEventListener('click', () => {
      sidebar.classList.toggle('open');
    });

    // Calculator Logic
    function appendInput(val) {
      display.value += val;
    }

    function clearDisplay() {
      display.value = '';
    }

    function deleteLast() {
      display.value = display.value.slice(0, -1);
    }

    function calculateResult() {
      try {
        if (display.value.trim() !== '') {
          display.value = Function('"use strict";return (' + display.value + ')')();
        }
      } catch (e) {
        display.value = 'Error';
        setTimeout(() => clearDisplay(), 1200);
      }
    }
  </script>
</body>
</html>
